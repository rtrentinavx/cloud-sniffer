          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  usage_date AS \"time\",\n  SUM(total_cost)::double precision AS spend\nFROM cost_daily_rollup\nWHERE usage_date >= CURRENT_DATE - INTERVAL '30 days'\nGROUP BY usage_date\nORDER BY usage_date;",
          "refId": "A"
