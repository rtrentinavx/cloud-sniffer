          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  SUM(unallocated_cost) * 100.0 / NULLIF(SUM(total_cost), 0) AS unallocated_pct\nFROM cost_daily_rollup\nWHERE usage_date = CURRENT_DATE - 1;",
          "refId": "A"
        }
      ],
      "title": "Yesterday unallocated %",
      "type": "stat"
    },
