          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  provider AS metric,\n  SUM(total_cost)::double precision AS value\nFROM cost_daily_rollup\nWHERE usage_date >= CURRENT_DATE - INTERVAL '30 days'\nGROUP BY provider\nORDER BY value DESC;",
          "refId": "A"
        }
