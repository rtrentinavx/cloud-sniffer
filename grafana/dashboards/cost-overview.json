          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  provider || ' / ' || service AS metric,\n  SUM(total_cost)::double precision AS value\nFROM cost_daily_rollup\nWHERE usage_date >= CURRENT_DATE - INTERVAL '30 days'\nGROUP BY provider, service\nORDER BY value DESC\nLIMIT 15;",
          "refId": "A"
        }
      ],
      "title": "30d spend by service (top 15)",
      "type": "bargauge"
