# Neon Postgres — use the **pooled** connection string in Vercel (see db/README.md)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Vercel billing ingest — FOCUS JSONL via GET /v1/billing/charges
# Create at https://vercel.com/account/tokens (billing read / team scope as required)
VERCEL_ACCESS_TOKEN=
# Team id (team_...) when ingesting a team; omit for personal scope (see README gaps)
VERCEL_TEAM_ID=

# Cron auth — Vercel sends Authorization: Bearer <CRON_SECRET> on scheduled invocations
CRON_SECRET=

# Optional: comma-separated tag keys required for allocation_status=allocated (future FinOps)
# REQUIRED_TAG_KEYS=team,env,project

# Upstash Redis — rate limits, alert dedup, ingest idempotency (later phases)
UPSTASH_REDIS_REST_URL=https://YOUR-REST-URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# Grafana Cloud — optional; manual datasource setup does not require these locally
# GRAFANA_CLOUD_STACK_URL=https://YOURORG.grafana.net
# GRAFANA_CLOUD_SERVICE_ACCOUNT_TOKEN=glsa_xxxxxxxx
# GRAFANA_CLOUD_DATASOURCE_UID=neon-postgres-cost
